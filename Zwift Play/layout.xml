<layout>
<!-- Direção -->
<row>
<button image="icons/arrow-left.png" scale="fit" text="Esquerda" ontap="left"/>
<button image="icons/arrow-up.png" scale="fit" text="Cima" ontap="up"/>
<button image="icons/arrow-right.png" scale="fit" text="Direita" ontap="right"/>
</row>

<!-- Down / U-turn + Confirmar -->
<row>
<button image="icons/arrow-rotate-left.png" scale="fit" text="U-Turn" ontap="down"/>
<button image="icons/circle-check.png" scale="fit" text="Confirmar" ontap="confirm"/>
</row>

<!-- Mudanças virtuais -->
<row>
<button image="icons/shift-down.png" scale="fit" text="Shift Down" ontap="shift_down"/>
<button image="icons/shift-up.png" scale="fit" text="Shift Up" ontap="shift_up"/>
</row>

<!-- Câmaras -->
<row>
<button image="icons/chevron-left.png" scale="fit" text="Câmara -" ontap="camera_prev"/>
<button image="icons/chevron-right.png" scale="fit" text="Câmara +" ontap="camera_next"/>
</row>
<!--   NOVOS - Atalhos Zwift   -->
<row>
<button image="icons/menu-end_ride.png" scale="fit" text="MENU ESC" ontap="esc"/>
<button image="icons/screen-shot.png" scale="fit" text="FOTO F10" ontap="f10"/>
<button image="icons/paired-devices.png" scale="fit" text="PAIRING A" ontap="a_key"/>
</row>
<row>
<button image="icons/workout-select.png" scale="fit" text="WORKOUT E" ontap="e_key"/>
<button image="icons/my-garage.png" scale="fit" text="GARAGE T" ontap="t_key"/>
<button image="icons/house-regular.png" scale="fit" text="GRUPO M" ontap="m_key"/>
</row>
</layout>


