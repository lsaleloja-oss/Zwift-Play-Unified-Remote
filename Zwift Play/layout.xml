<layout>
<row>
<button image="icons/arrow-left.png" scale="fit" text="TURN LEFT" ontap="left"/>
<button image="icons/arrow-up.png" scale="fit" text="UP - FUNCTION" ontap="up"/>
<button image="icons/arrow-right.png" scale="fit" text="TURN RIGHT" ontap="right"/>
</row>
<row>
<button image="icons/arrow-rotate-left.png" scale="fit" text="U-TURN / BRAKE / DOWN" ontap="down"/>
<button image="icons/bolt.png" scale="fit" text="POWER UP" ontap="powerup"/>
<button image="icons/circle-check.png" scale="fit" text="CONFIRM / SELECT" ontap="confirm"/>
</row>
<row>
<button image="icons/shift-down.png" scale="fit" text="VIRTUAL SHIFTER -" ontap="shift_down"/>
<button image="icons/thumbs-up.png" scale="fit" text="RIDE ON" ontap="rideon"/>
<button image="icons/shift-up.png" scale="fit" text="VIRTUAL SHIFTER +" ontap="shift_up"/>
</row>
<row>
<button image="icons/chevron-left.png" scale="fit" text="CAMERA PREVIOUS" ontap="camera_prev"/>
<button image="icons/bomb.png" scale="fit" text="RIDE ON BOMB" ontap="rideon_bomb"/>
<button image="icons/chevron-right.png" scale="fit" text="CAMERA NEXT" ontap="camera_next"/>
</row>
<row>
<button image="icons/menu-end_ride.png" scale="fit" text="MENU / END RIDE" ontap="esc"/>
<button image="icons/screen-shot.png" scale="fit" text="SCREEN SHOT" ontap="f10"/>
<button image="icons/paired-devices.png" scale="fit" text="PAIRED DEVICES" ontap="a_key"/>
</row>
<row>
<button image="icons/workout-select.png" scale="fit" text="WORKOUT SELECT" ontap="e_key"/>
<button image="icons/my-garage.png" scale="fit" text="MY GARAGE" ontap="t_key"/>
<button image="icons/house-regular.png" scale="fit" text="GROUP MESSAGE" ontap="m_key"/>
</row>
</layout>


